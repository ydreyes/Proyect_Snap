<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SnapClone.Android</RootNamespace>
    <ApplicationId>com.integritysolution.snapclone</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\SnapClone\**\*.cs"
             Exclude="..\SnapClone\Program.cs;..\SnapClone\bin\**;..\SnapClone\obj\**"
             LinkBase="Game" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.6" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.6" />
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="..\SnapClone\Content\Content.mgcb" Link="Content\Content.mgcb" />
  </ItemGroup>
</Project>
